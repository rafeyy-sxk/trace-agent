# Required. Get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional. Overrides live model discovery with an explicit model id.
# Leave unset to let the app pick the best available chat model from
# https://api.groq.com/openai/v1/models at runtime.
# TRACE_AGENT_MODEL=openai/gpt-oss-120b
